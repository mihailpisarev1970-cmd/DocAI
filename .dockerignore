# ═══════════════════════════════════════════════════════════════════════════
# Что НЕ отправлять в контекст сборки Docker
# ═══════════════════════════════════════════════════════════════════════════

# Виртуальное окружение хоста
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Секреты НЕ исключаем — они нужны внутри образа через env_file,
# но .env копируется отдельно в compose, в образ не попадает.
# Здесь исключаем только мусор:

# База и логи (монтируются томами)
backend/db.sqlite3
backend/db.sqlite3.bak
backend/logs/
backend/staticfiles/

# Git и IDE
.git/
.gitignore
.vscode/
.idea/

# Документация и временные файлы
*.md
!deploy/README.md
_*.py
_*.sh
*.log
