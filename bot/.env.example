# ═══════════════════════════════════════════════════════════════════════════
# DocAI Bot — переменные окружения
# Скопируйте в bot/.env и заполните реальными значениями
# ═══════════════════════════════════════════════════════════════════════════

# 1. Токен бота от @BotFather (/newbot)
BOT_TOKEN=

# 2. Адрес Django-бэкенда
#    Локально: http://127.0.0.1:8000
#    На сервере с nginx: http://127.0.0.1 (порт 80 через nginx)
BACKEND_URL=http://127.0.0.1:8000

# 3. Секретный ключ связи с бэкендом.
#    ДОЛЖЕН совпадать с BOT_API_KEY в backend/.env
BOT_API_KEY=

# 4. Ключ и адрес нейросети
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aidostup.site/v1
OPENAI_MODEL=claude-opus-5-5

# 5. Ожидание подтверждения оплаты (секунды)
PAYMENT_POLL_TIMEOUT=180
PAYMENT_POLL_INTERVAL=5
