# Автонормализация переводов строк
* text=auto LF

# Python
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Shell-скрипты (Linux не принимает CRLF)
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf

# Windows-специфичные
*.bat text eol=crlf
*.cmd text eol=crlf

# Бинарные файлы — без обработки
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
